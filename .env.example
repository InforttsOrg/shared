# Shared Infortts package environment configuration.
# These variables are read by the shared Python clients/services (notification_*,
# infortts_logger/observability_*) when consumed by project production/CI runtimes.
# Shell defaults exist, so declare only overrides here.
# This file is a template — never put real secrets in it.

# ── Notifications ────────────────────────────────────────────────────────
# Push notification gateway base URL used by send_push_notification().
PUSH_GATEWAY_URL=http://127.0.0.1:8035/api/v1/notify

# Notification gateway bind port (notification_gateway.py, default 8035).
NOTIFY_PORT=8035

# Optional explicit SQLite path for queued notifications
# (defaults to ~/.infortts_notifications.db).
NOTIFICATION_DB_PATH=

# Channel credentials — inject at runtime, leave blank in the template.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BREVO_API_KEY=

# ── Observability ────────────────────────────────────────────────────────
# Central observability log server used by infortts_logger.py.
OBSERVABILITY_URL=http://127.0.0.1:8091
OBSERVABILITY_PORT=8091
# Legacy alias honoured by infortts_observability_server.py.
LOG_SERVER_PORT=8091
# Override the SQLite fallback location (default: cache/observability.db).
OBSERVABILITY_SQLITE_PATH=

# PostgreSQL primary store — inject credentials at runtime (never commit them).
POSTGRES_URL=

# ── Inference / messaging backends ───────────────────────────────────────
NATS_URL=nats://infortts-nats-shared:4222
OLLAMA_BASE_URL=http://infortts-ollama:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# ── CDN / auth ───────────────────────────────────────────────────────────
# Hugging Face token for scripts/publish_hf_ota.py (OTA patch publishing).
HF_TOKEN=

# Glycocalyx / Supabase auth base used by AuthConfig in lib/auth.dart.
# Overridable at build time with --dart-define=WAPTIA_AUTH_BASE=...
WAPTIA_AUTH_BASE=

# Supabase anon key used for profile lookups by the shared auth client.
# Overridable at build time with --dart-define=SUPABASE_ANON_KEY=...
SUPABASE_ANON_KEY=
