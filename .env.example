# Shared Infortts package environment configuration.
# These variables are read by shared Python clients (e.g. notification_client.py)
# when consumed by project production/CI runtimes. Shell defaults exist.

# Push notification gateway base URL used by send_push_notification().
PUSH_GATEWAY_URL=http://127.0.0.1:8030/api/v1/notify

# Glycocalyx / Supabase auth base used by AuthConfig in lib/auth.dart.
# Overridable at build time with --dart-define=WAPTIA_AUTH_BASE=...
WAPTIA_AUTH_BASE=

# Supabase anon key used for profile lookups by the shared auth client.
# Overridable at build time with --dart-define=SUPABASE_ANON_KEY=...
SUPABASE_ANON_KEY=