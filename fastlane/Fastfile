default_platform(:android)

platform :android do
  desc "Deploy app to Google Play Store Internal Testing Track for managed tester email list"
  lane :internal do
    # 1. Build release AAB using Flutter
    sh("flutter", "build", "appbundle", "--release")

    # 2. Locate service account credentials
    json_key_file = File.exist?('/Users/admin/Downloads/infortts-mobile-deployment-key.json') ? 
      '/Users/admin/Downloads/infortts-mobile-deployment-key.json' : 
      '/Users/admin/Downloads/infortts-57f65b1569af.json'

    aab_path = File.expand_path('../build/app/outputs/bundle/release/app-release.aab', __dir__)

    # 3. Upload AAB to Internal Track for managed email list
    upload_to_play_store(
      track: 'internal',
      json_key: json_key_file,
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'completed'
    )

    UI.message("✅ Successfully deployed to Google Play Internal Testing Track for managed tester email list!")
  end
end
